numid;

usevariables= 
structuring_task_mother_master
  thought_clarity_mother_master
  explain_posit_mother_master
  off_task_mother_master
  attempted_resolution_mother_master;
  
  idvariable = numid;

missing = all(999);
analysis:
!estimator = mlr; !pos variables not skewed/kurtotic;

model:
poscom by structuring_task_mother_master*
  thought_clarity_mother_master
  explain_posit_mother_master
  off_task_mother_master
  attempted_resolution_mother_master; !note not in epi;
  
  thought_clarity_mother_master with
  explain_posit_mother_master;


poscom@1;

savedata:
file is ppositivecomscores_negtask.csv;
save = fscores;

OUTPUT:	TECH1 STANDARDIZED modindices;
